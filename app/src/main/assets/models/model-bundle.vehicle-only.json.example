{
  "provider": "CPU",
  "schedule": { "laneEveryFrames": 3, "plateEveryFrames": 3 },
  "vehicle": {
    "assetPath": "models/vehicle/model.onnx",
    "labels": { "0": "car", "1": "bus", "2": "truck" },
    "decode": { "confidence": 0.4, "nmsIou": 0.5, "maxDetections": 100 },
    "contract": {
      "id": "REPLACE_AFTER_REVIEW",
      "version": "REPLACE",
      "sha256": "REPLACE_WITH_64_HEX",
      "input": { "name": "images", "shape": [1, 3, 640, 640] },
      "outputs": [{ "name": "detections", "shape": [1, -1, 6] }],
      "layout": "NCHW",
      "colorOrder": "RGB",
      "scale": 0.0039215686,
      "mean": [0, 0, 0],
      "std": [1, 1, 1]
    }
  }
}
