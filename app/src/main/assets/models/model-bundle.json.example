{
  "provider": "CPU",
  "schedule": { "laneEveryFrames": 3, "plateEveryFrames": 3 },
  "vehicle": {
    "assetPath": "models/vehicle/model.onnx",
    "labels": { "0": "car", "1": "bus", "2": "truck" },
    "contract": {
      "id": "REPLACE_AFTER_REVIEW", "version": "REPLACE", "sha256": "REPLACE_WITH_64_HEX",
      "input": { "name": "images", "shape": [1, 3, 640, 640] },
      "outputs": [{ "name": "detections", "shape": [1, -1, 6] }],
      "layout": "NCHW", "colorOrder": "RGB", "scale": 0.0039215686,
      "mean": [0, 0, 0], "std": [1, 1, 1]
    }
  },
  "lane": {
    "assetPath": "models/lane/model.onnx",
    "contract": {
      "id": "REPLACE_AFTER_REVIEW", "version": "REPLACE", "sha256": "REPLACE_WITH_64_HEX",
      "input": { "name": "images", "shape": [1, 3, 288, 800] },
      "outputs": [{ "name": "lane_mask", "shape": [1, 1, 288, 800] }],
      "layout": "NCHW", "colorOrder": "RGB", "scale": 0.0039215686
    }
  },
  "plate": {
    "assetPath": "models/plate/model.onnx",
    "contract": {
      "id": "REPLACE_AFTER_REVIEW", "version": "REPLACE", "sha256": "REPLACE_WITH_64_HEX",
      "input": { "name": "images", "shape": [1, 3, 640, 640] },
      "outputs": [{ "name": "detections", "shape": [1, -1, 6] }],
      "layout": "NCHW", "colorOrder": "RGB", "scale": 0.0039215686
    }
  },
  "ocr": {
    "assetPath": "models/ocr/model.onnx",
    "alphabet": ["A", "B"],
    "blankIndex": 2,
    "contract": {
      "id": "REPLACE_AFTER_REVIEW", "version": "REPLACE", "sha256": "REPLACE_WITH_64_HEX",
      "input": { "name": "images", "shape": [1, 3, 48, 160] },
      "outputs": [{ "name": "logits", "shape": [1, -1, 3] }],
      "layout": "NCHW", "colorOrder": "RGB", "scale": 0.0039215686
    }
  }
}
